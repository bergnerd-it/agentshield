{
  "build": {
    "dockerfile": ".air/Dockerfile",
    "context": "."
  },
  "environment": [
    {
      "type": "env",
      "key": "CI",
      "value": "true"
    },
    {
      "type": "env",
      "key": "UV_PYTHON",
      "value": "3.14"
    }
  ],
  "setup": [
    "git --version && uv --version && node --version && pnpm --version",
    "cd backend && uv sync --frozen",
    "cd frontend && pnpm install --frozen-lockfile"
  ],
  "user": {
    "user": "agent",
    "group": "agent"
  }
}
